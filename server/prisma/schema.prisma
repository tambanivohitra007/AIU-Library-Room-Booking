// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  STUDENT_WORKER
  ADMIN
  SUPERADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  password  String?
  provider  String    @default("LOCAL")
  role      UserRole  @default(STUDENT)
  status    UserStatus @default(ACTIVE)
  language  String    @default("en") // UI/email language preference: "en" | "th"
  avatarUrl String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
  managedDepartments DepartmentAdmin[]
}

model Department {
  id             String   @id @default(uuid())
  name           String
  contactEmail   String?
  operatingHours String?  // same JSON format as ServiceSettings.operatingHours; null = inherit global
  createdAt      DateTime @default(now())
  rooms          Room[]
  admins         DepartmentAdmin[]
  scheduleExceptions ScheduleException[]
}

// Date-specific schedule overrides: holidays, maintenance closures,
// or special hours (e.g. exam-week extended opening)
model ScheduleException {
  id           String      @id @default(uuid())
  name         String      // "Christmas Day", "Exam Week Extended Hours"
  startDate    DateTime
  endDate      DateTime    // inclusive; same as startDate for one-day entries
  closed       Boolean     @default(true)
  openHour     Int?        // used when closed = false
  closeHour    Int?
  departmentId String?     // null = applies service-wide
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
}

// Grants a user management rights over one department (rooms, bookings, hours)
model DepartmentAdmin {
  id           String     @id @default(uuid())
  userId       String
  departmentId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model Room {
  id           String      @id @default(uuid())
  name         String
  minCapacity  Int
  maxCapacity  Int
  description  String
  features     String      // JSON string array
  bookingTerms String?     // terms & conditions text; null = no acceptance required
  requiresApproval Boolean @default(false) // bookings start as PENDING until approved
  operatingHours String?   // same JSON format as ServiceSettings.operatingHours; null = inherit the department (or global) schedule
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  bookings     Booking[]
}

model Booking {
  id        String         @id @default(uuid())
  roomId    String
  userId    String
  startTime DateTime
  endTime   DateTime
  purpose   String
  status    BookingStatus  @default(CONFIRMED)
  cancellationReason String?
  reminderSent Boolean     @default(false)
  termsAcceptedAt DateTime?  // when the booker accepted the room's terms (audit)
  createdAt DateTime       @default(now())

  room      Room           @relation(fields: [roomId], references: [id])
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendees Attendee[]
}

model Attendee {
  id          String   @id @default(uuid())
  bookingId   String
  name        String
  studentId   String?
  isCompanion Boolean  @default(true)

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Semester {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ServiceSettings {
  id           String   @id @default(uuid())
  serviceName  String   @default("Room Booking")
  logoUrl      String?
  contactEmail String?
  websiteUrl   String?
  description  String?
  allowedEmailDomains String?  // comma-separated list; null/empty = any domain may sign up
  operatingHours      String?  // JSON array of 7 entries (Sun..Sat): {open, close} in hours, or null = closed; null field = default hours
  allowSelfRegistration Boolean @default(false) // false = accounts only via SSO, admin creation, or import
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Append-only trail of privileged actions: who did what, to what, and when.
//
// The actor is stored DENORMALISED with no foreign key to User on purpose. A
// relation would either block deleting a user or (matching Booking's cascade)
// erase their history along with them - and "the admin who did this no longer
// exists" is exactly when the trail matters most. The same applies to
// targetLabel: it captures the name as it was, so renaming or deleting a room
// later does not rewrite the past.
model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  // null = performed by the system (e.g. the booking scheduler)
  actorEmail   String   @default("system")
  actorName    String   @default("System")
  actorRole    String   @default("SYSTEM")
  action       String   // e.g. BOOKING_APPROVE, ROOM_UPDATE, USER_ROLE_CHANGE
  targetType   String   // Booking | Room | Department | ScheduleException | Semester | User | ServiceSettings
  targetId     String?
  targetLabel  String?  // human-readable identity at the time of the action
  departmentId String?  // scopes the trail so a department admin sees only their own
  summary      String?  // short sentence describing the change
  metadata     String?  // compact JSON: reason, before/after values
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([departmentId])
}

